{
  "name": "code-walkthrough-engine",
  "version": "0.1.0",
  "description": "Executes Walkthrough IR v1: validates it, compiles it into a standalone IDE-like animated HTML player, or serves it on localhost. Also collects change context for authoring.",
  "type": "module",
  "bin": {
    "code-walkthrough": "dist/cli.mjs",
    "code-walkthrough-collect": "dist/collect.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "docs",
    "schema"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run build && node --test test/*.test.ts",
    "check:skill": "node scripts/build.mjs --check",
    "prepack": "npm run build"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/syi0808/code-change-walkthrough-skill/main/packages/engine/schema/walkthrough-ir.v1.schema.json",
  "title": "Walkthrough IR v1",
  "description": "Authoring IR consumed by the code-walkthrough engine. Structural schema only: anchor resolution and cross-references are checked by `code-walkthrough check`.",
  "type": "object",
  "required": ["version", "meta", "chapters"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "intent": { "type": "string" },
        "language": { "type": "string" },
        "audience": { "enum": ["reviewer", "newcomer", "author"] },
        "strategy": {
          "type": "object",
          "properties": { "order": { "type": "string" }, "rationale": { "type": "string" } }
        },
        "takeaways": { "type": "array", "items": { "type": "string" } },
        "reviewFocus": { "type": "array", "items": { "type": "string" } },
        "impact": { "type": "array", "description": "What outside the diff the change reaches (callers, data, config, other services) and how", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "effect": { "$ref": "#/$defs/effect" }, "files": { "type": "array", "items": { "type": "string" } } } } }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "repo": { "type": "string" },
        "range": { "type": "string", "description": "A...B (from merge-base) or A..B" },
        "base": { "type": "string" },
        "head": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": { "enum": ["added", "modified", "deleted", "renamed", "copied", "context"] },
          "oldPath": { "type": "string" },
          "role": { "type": "string" },
          "language": { "type": "string" },
          "before": { "type": ["string", "null"] },
          "after": { "type": ["string", "null"] }
        }
      }
    },
    "tour": {
      "oneOf": [
        { "const": false },
        { "type": "object", "properties": {
          "order": { "type": "array", "items": { "type": "string" } },
          "tempo": { "type": "object", "additionalProperties": { "enum": ["key", "normal", "skim"] } },
          "questions": { "type": "object", "additionalProperties": { "type": "string" } } } }
      ]
    },
    "glossary": {
      "type": "array",
      "items": { "type": "object", "required": ["term", "definition"], "properties": { "term": { "type": "string" }, "definition": { "type": "string" } } }
    },
    "chapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chapter" } }
  },
  "$defs": {
    "effect": { "enum": ["safe", "check", "breaks", "updated"], "description": "safe: unaffected · check: needs a look · breaks: broken by the change · updated: changed along with it" },
    "chapter": {
      "type": "object",
      "required": ["title", "scenes"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "goal": { "type": "string" },
        "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "title", "narration", "steps"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "goal": { "type": "string" },
        "question": { "type": "string", "description": "the question the viewer has at this point; this scene answers it" },
        "at": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string" }, "hunk": { "type": "integer", "minimum": 1 } }, "description": "play right after the tour replays this hunk / file" },
        "bridge": { "type": "string", "description": "why this scene follows the previous one (transition card)" },
        "narration": { "type": "string" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      }
    },
    "line": { "type": "integer", "minimum": 1 },
    "side": { "enum": ["before", "after"] },
    "anchor": {
      "oneOf": [
        { "$ref": "#/$defs/line" },
        { "type": "array", "items": { "$ref": "#/$defs/line" }, "minItems": 1, "maxItems": 2 },
        { "type": "object", "required": ["line"], "properties": { "line": { "$ref": "#/$defs/line" }, "span": { "type": "integer", "minimum": 1 }, "side": { "$ref": "#/$defs/side" } }, "additionalProperties": false },
        { "type": "object", "required": ["lines"], "properties": { "lines": { "type": "array", "items": { "$ref": "#/$defs/line" }, "minItems": 1, "maxItems": 2 }, "side": { "$ref": "#/$defs/side" } }, "additionalProperties": false },
        { "type": "object", "required": ["find"], "properties": { "find": { "type": "string", "minLength": 1 }, "nth": { "type": "integer", "minimum": 1 }, "span": { "type": "integer", "minimum": 1 }, "block": { "type": "boolean" }, "side": { "$ref": "#/$defs/side" } }, "additionalProperties": false },
        { "type": "object", "required": ["regex"], "properties": { "regex": { "type": "string" }, "nth": { "type": "integer", "minimum": 1 }, "span": { "type": "integer", "minimum": 1 }, "block": { "type": "boolean" }, "side": { "$ref": "#/$defs/side" } }, "additionalProperties": false },
        { "type": "object", "required": ["symbol"], "properties": { "symbol": { "type": "string" }, "nth": { "type": "integer", "minimum": 1 }, "head": { "type": "boolean" }, "side": { "$ref": "#/$defs/side" } }, "additionalProperties": false },
        { "type": "object", "required": ["hunk"], "properties": { "hunk": { "type": "integer", "minimum": 1 }, "side": { "$ref": "#/$defs/side" } }, "additionalProperties": false }
      ]
    },
    "view": { "enum": ["after", "before", "diff"] },
    "pane": { "enum": [0, 1] },
    "diffOptions": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["unified", "split"] },
        "algorithm": { "enum": ["patience", "myers"] },
        "granularity": { "enum": ["word", "line"] },
        "context": { "type": ["integer", "null"], "minimum": 0 },
        "whitespace": { "enum": ["collapse", "show"] }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["do"],
      "properties": {
        "do": { "enum": ["open", "close", "layout", "diffView", "reveal", "highlight", "focus", "unfocus", "note", "type", "replay", "goto", "refs", "impact", "graph", "say", "wait", "clear", "delete"] },
        "pane": { "$ref": "#/$defs/pane" },
        "file": { "type": "string" },
        "view": { "$ref": "#/$defs/view" },
        "ms": { "type": "number", "minimum": 0 },
        "hold": { "type": "number", "minimum": 0 },
        "with": { "type": "boolean" },
        "cue": { "type": "integer", "minimum": 1, "description": "narration item (sentence or bullet, 1-based) that appears when this step starts" }
      },
      "allOf": [
        { "if": { "properties": { "do": { "const": "open" } } }, "then": { "required": ["file"], "properties": { "at": { "$ref": "#/$defs/anchor" }, "diff": { "$ref": "#/$defs/diffOptions" } } } },
        { "if": { "properties": { "do": { "const": "close" } } }, "then": { "required": ["file"] } },
        { "if": { "properties": { "do": { "const": "delete" } } }, "then": { "required": ["file"] } },
        { "if": { "properties": { "do": { "const": "layout" } } }, "then": { "required": ["mode"], "properties": { "mode": { "enum": ["single", "columns"] } } } },
        { "if": { "properties": { "do": { "const": "diffView" } } }, "then": { "properties": { "mode": { "enum": ["unified", "split"] }, "algorithm": { "enum": ["patience", "myers"] }, "granularity": { "enum": ["word", "line"] }, "context": { "type": ["integer", "null"] }, "whitespace": { "enum": ["collapse", "show"] } } } },
        { "if": { "properties": { "do": { "const": "reveal" } } }, "then": { "required": ["at"], "properties": { "at": { "$ref": "#/$defs/anchor" }, "align": { "enum": ["center", "top"] } } } },
        { "if": { "properties": { "do": { "const": "highlight" } } }, "then": { "required": ["range"], "properties": { "range": { "$ref": "#/$defs/anchor" }, "tone": { "enum": ["focus", "add", "remove", "info", "warn"] }, "label": { "type": "string" }, "reveal": { "type": "boolean" } } } },
        { "if": { "properties": { "do": { "const": "focus" } } }, "then": { "required": ["range"], "properties": { "range": { "$ref": "#/$defs/anchor" } } } },
        { "if": { "properties": { "do": { "const": "type" } } }, "then": { "required": ["range"], "properties": { "range": { "$ref": "#/$defs/anchor" } } } },
        { "if": { "properties": { "do": { "const": "note" } } }, "then": { "required": ["at", "text"], "properties": { "at": { "$ref": "#/$defs/anchor" }, "text": { "type": "string", "maxLength": 400 }, "tone": { "enum": ["info", "why", "risk", "tip"] } } } },
        { "if": { "properties": { "do": { "const": "goto" } } }, "then": { "required": ["from", "to"], "properties": {
          "from": { "type": "object", "required": ["at", "token"], "properties": { "at": { "$ref": "#/$defs/anchor" }, "token": { "type": "string" }, "file": { "type": "string" }, "view": { "$ref": "#/$defs/view" } } },
          "to": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string" }, "at": { "$ref": "#/$defs/anchor" }, "view": { "$ref": "#/$defs/view" }, "pane": { "$ref": "#/$defs/pane" } } } } } },
        { "if": { "properties": { "do": { "const": "impact" } } }, "then": { "required": ["items"], "properties": { "symbol": { "type": "string" }, "change": { "type": "string" }, "title": { "type": "string" }, "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["file", "at"], "properties": { "file": { "type": "string" }, "at": { "$ref": "#/$defs/anchor" }, "label": { "type": "string" }, "view": { "$ref": "#/$defs/view" }, "effect": { "$ref": "#/$defs/effect" }, "relation": { "type": "string" } } } } } } },
        { "if": { "properties": { "do": { "const": "refs" } } }, "then": { "required": ["items"], "properties": { "symbol": { "type": "string" }, "title": { "type": "string" }, "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["file", "at"], "properties": { "file": { "type": "string" }, "at": { "$ref": "#/$defs/anchor" }, "label": { "type": "string" }, "view": { "$ref": "#/$defs/view" } } } } } } },
        { "if": { "properties": { "do": { "const": "graph" } } }, "then": { "properties": {
          "hide": { "type": "boolean" }, "title": { "type": "string" }, "size": { "enum": ["panel", "full"] },
          "highlight": { "type": "array", "items": { "type": "string" } },
          "nodes": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "sub": { "type": "string" }, "file": { "type": "string" }, "status": { "enum": ["added", "modified", "deleted", "renamed", "context"] } } } },
          "edges": { "type": "array", "items": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "label": { "type": "string" }, "style": { "enum": ["solid", "dashed"] } } } } } } },
        { "if": { "properties": { "do": { "const": "say" } } }, "then": { "required": ["text"], "properties": { "text": { "type": "string" } } } },
        { "if": { "properties": { "do": { "const": "wait" } } }, "then": { "required": ["ms"] } }
      ]
    }
  }
}

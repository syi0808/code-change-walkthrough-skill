    "test/retry.test.ts": {
      "status": "added"
    }
  },
  "glossary": [
    {
      "term": "idempotent",
      "definition": "A request whose effect is the same no matter how many times it runs, so retrying it is safe."
    },
    {
      "term": "exponential backoff",
      "definition": "Waiting base × 2^n between retries to avoid hammering a struggling server."
    }
  ],
